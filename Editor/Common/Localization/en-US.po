msgid "TextureCompressor:label:preset"
msgstr "Compression Preset"

msgid "TextureCompressor:label:presetHighQuality:tooltip"
msgstr "Highest quality\nMinimal compression"

msgid "TextureCompressor:message:presetHighQualityDescription"
msgstr "High Quality Mode: Maximum quality preservation with minimal compression. Only very simple textures (solid colors) will be slightly compressed. Best for showcase avatars or when VRAM is not a concern."

msgid "TextureCompressor:label:presetQuality:tooltip"
msgstr "Good quality\nLight compression"

msgid "TextureCompressor:message:presetQualityDescription"
msgstr "Quality Mode: Preserves texture detail as much as possible. Only low-complexity textures (solid colors, simple gradients) will be compressed. Best for avatars where visual quality is the priority."

msgid "TextureCompressor:label:presetBalanced:tooltip"
msgstr "Balance of\nquality and size"

msgid "TextureCompressor:message:presetBalancedDescription"
msgstr "Balanced Mode: Good compromise between quality and VRAM savings. Detailed textures are preserved, while simpler textures are compressed. Recommended for most use cases."

msgid "TextureCompressor:label:presetAggressive:tooltip"
msgstr "Smaller file size\nSome quality loss"

msgid "TextureCompressor:message:presetAggressiveDescription"
msgstr "Aggressive Mode: Prioritizes smaller file size over quality. Most textures will be compressed to some degree. Good for Quest avatars or when VRAM is limited."

msgid "TextureCompressor:label:presetMaximum:tooltip"
msgstr "Smallest size\nNoticeable quality loss"

msgid "TextureCompressor:message:presetMaximumDescription"
msgstr "Maximum Compression: Compresses all textures as much as possible. Significant quality loss may occur. Use only when file size is critical."

msgid "TextureCompressor:label:presetCustom:tooltip"
msgstr "Manual\nconfiguration"

msgid "TextureCompressor:message:presetCustomDescription"
msgstr "Custom Mode: Full control over all compression settings. Configure each parameter manually for fine-tuned results."

